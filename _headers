# Cache rules for the live site (read by Cloudflare Pages and Netlify).
#
# "no-cache" does NOT mean "don't cache" — it means the browser may keep the
# file but must check with the server each visit. Unchanged files come back as
# a tiny "304 Not Modified" (fast, no re-download); changed files are fetched
# fresh. Net effect: the site stays fast on repeat visits, but your edits and
# swapped-in photos always show without anyone hard-refreshing.

/index.html
  Cache-Control: no-cache

/config.js
  Cache-Control: no-cache

/source/*
  Cache-Control: no-cache
